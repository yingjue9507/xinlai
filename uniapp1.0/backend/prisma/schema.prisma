generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id              String   @id @default(uuid())
  phoneNumber     String   @unique @map("phone_number")
  password        String?  @map("password")
  registrationDate DateTime @default(now()) @map("registration_date")
  lastLoginDate   DateTime @default(now()) @map("last_login_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ledgers         Ledger[]
  contacts        Contact[]
  massSendLogs    MassSendLog[]
  announcements   Announcement[]
  ocrSessions     OcrSession[]

  @@map("users")
}

model Ledger {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  ledgerName     String   @map("ledger_name")
  ledgerType     String   @map("ledger_type")
  occasion       String
  creationDate   DateTime @default(now()) @map("creation_date")
  lastUpdateDate DateTime @updatedAt @map("last_update_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  records        Record[]
  massSendLogs   MassSendLog[]
  ocrSessions    OcrSession[]

  @@index([userId])
  @@map("ledgers")
}

model Record {
  id              String   @id @default(uuid())
  ledgerId        String   @map("ledger_id")
  contactName     String   @map("contact_name")
  amount          Float    @default(0)
  isGiftItem      Boolean  @default(false) @map("is_gift_item")
  giftDescription String?  @map("gift_description")
  note            String?
  recordDate      DateTime @map("record_date")
  recordType      String @default("received") @map("record_type")
  creationDate    DateTime @default(now()) @map("creation_date")
  lastUpdateDate  DateTime @updatedAt @map("last_update_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ledger          Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
  @@index([contactName])
  @@index([recordType])
  @@map("records")
}

model OcrSession {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  ledgerId   String      @map("ledger_id")
  status     String      @default("draft")
  expiresAt  DateTime    @map("expires_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger     Ledger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  pages      OcrPage[]

  @@index([userId])
  @@index([ledgerId])
  @@index([status, expiresAt])
  @@map("ocr_sessions")
}

model OcrPage {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  pageNumber  Int       @map("page_number")
  imagePath   String    @map("image_path")
  status      String    @default("processing")
  rawResponse String?   @map("raw_response")
  errorMessage String?  @map("error_message")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  session     OcrSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rows        OcrRow[]

  @@unique([sessionId, pageNumber])
  @@index([sessionId])
  @@map("ocr_pages")
}

model OcrRow {
  id              String   @id @default(uuid())
  pageId          String   @map("page_id")
  rowIndex        Int      @map("row_index")
  contactName     String   @default("") @map("contact_name")
  amount          Float    @default(0)
  isGiftItem      Boolean  @default(false) @map("is_gift_item")
  giftDescription String?  @map("gift_description")
  note            String?
  recordDate      DateTime
  recordType      String   @default("received") @map("record_type")
  needsReview     Boolean  @default(true) @map("needs_review")
  reviewNote      String?  @map("review_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  page            OcrPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, rowIndex])
  @@index([pageId])
  @@map("ocr_rows")
}

model Contact {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  contactName     String   @map("contact_name")
  phoneNumber     String?  @map("phone_number")
  totalReceived   Float    @default(0) @map("total_received")
  totalGiven      Float    @default(0) @map("total_given")
  lastContactDate DateTime @default(now()) @map("last_contact_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactName])
  @@index([userId])
  @@map("contacts")
}

model NotificationTemplate {
  id              String   @id @default(uuid())
  templateName    String   @map("template_name")
  templateContent String   @map("template_content")
  templateType    String   @map("template_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model MassSendLog {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  ledgerId              String?  @map("ledger_id")
  sendTime              DateTime @default(now()) @map("send_time")
  recipientCount        Int      @map("recipient_count")
  messageContentSummary String   @map("message_content_summary")
  status                String   @default("success")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger                Ledger?  @relation(fields: [ledgerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("mass_send_logs")
}

model Announcement {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String   // 公告标题
  content     String   // 公告内容
  eventType   String   @map("event_type") // 事件类型：红事、白事
  eventDate   DateTime @map("event_date") // 事件日期
  location    String?  // 地点
  contactInfo String?  @map("contact_info") // 联系方式
  isActive    Boolean  @default(true) @map("is_active") // 是否激活显示
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([eventDate])
  @@index([createdAt])
  @@map("announcements")
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("a_users")
}

model SystemAnnouncement {
  id        String   @id @default(uuid())
  title     String
  content   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_announcements")
}
